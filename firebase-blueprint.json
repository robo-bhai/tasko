{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for customer, service partner, or administrator.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID (auth UID or system ID)."
        },
        "name": {
          "type": "string",
          "description": "Full display name."
        },
        "email": {
          "type": "string",
          "description": "Email address."
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number."
        },
        "role": {
          "type": "string",
          "description": "Role in the system.",
          "enum": ["customer", "provider", "admin"]
        },
        "address": {
          "type": "string",
          "description": "Delivery or service address in Khanewal."
        },
        "fcmToken": {
          "type": "string",
          "description": "Firebase Cloud Messaging Web Push device token for notifications."
        },
        "isOnline": {
          "type": "boolean",
          "description": "Provider online availability status."
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp."
        }
      },
      "required": ["id", "name", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order for technician, delivery ride, or cargo transport.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order identifier (e.g. KC-1029)."
        },
        "customerId": {
          "type": "string",
          "description": "UID of the customer who placed the order."
        },
        "customerName": {
          "type": "string",
          "description": "Customer display name."
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer contact phone."
        },
        "serviceCategory": {
          "type": "string",
          "description": "Category: custom_delivery, home_services, transport_cargo, event_planner."
        },
        "serviceName": {
          "type": "string",
          "description": "Specific service requested."
        },
        "pickupAddress": {
          "type": "string",
          "description": "Pickup or task location in Khanewal."
        },
        "dropoffAddress": {
          "type": "string",
          "description": "Drop-off location if delivery/cargo."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total payable amount in PKR."
        },
        "paymentMethod": {
          "type": "string",
          "description": "COD, JazzCash, EasyPaisa, or Raast."
        },
        "status": {
          "type": "string",
          "description": "Current lifecycle status of the order.",
          "enum": ["pending", "accepted", "in_transit", "completed", "cancelled"]
        },
        "providerId": {
          "type": "string",
          "description": "Assigned technician or driver ID."
        },
        "providerName": {
          "type": "string",
          "description": "Name of assigned technician or driver."
        },
        "providerPhone": {
          "type": "string",
          "description": "Phone number of assigned worker."
        },
        "etaMinutes": {
          "type": "number",
          "description": "Estimated arrival time in minutes."
        },
        "customNote": {
          "type": "string",
          "description": "Dispatch or order details."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when order was created."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when order was last updated."
        }
      },
      "required": ["id", "customerId", "serviceCategory", "serviceName", "status", "totalAmount"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time in-app notification message for user or admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique notification ID."
        },
        "recipientId": {
          "type": "string",
          "description": "Target user ID or 'all_admins'."
        },
        "recipientRole": {
          "type": "string",
          "description": "Target role (admin, customer, provider).",
          "enum": ["admin", "customer", "provider", "all"]
        },
        "title": {
          "type": "string",
          "description": "Short notification title."
        },
        "body": {
          "type": "string",
          "description": "Full notification message body."
        },
        "orderId": {
          "type": "string",
          "description": "Associated order ID if applicable."
        },
        "type": {
          "type": "string",
          "description": "Notification category.",
          "enum": ["order_created", "order_assigned", "order_status", "system_alert"]
        },
        "isRead": {
          "type": "boolean",
          "description": "Whether recipient has viewed this alert."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        }
      },
      "required": ["id", "recipientId", "title", "body", "type", "isRead", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback on completed order.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Review ID."
        },
        "orderId": {
          "type": "string",
          "description": "Associated completed order ID."
        },
        "customerName": {
          "type": "string",
          "description": "Name of reviewing customer."
        },
        "serviceName": {
          "type": "string",
          "description": "Service reviewed."
        },
        "rating": {
          "type": "number",
          "description": "Star rating 1 to 5."
        },
        "comment": {
          "type": "string",
          "description": "Review text."
        },
        "createdAt": {
          "type": "string",
          "description": "Review submission timestamp."
        }
      },
      "required": ["id", "customerName", "serviceName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles including role and FCM device token."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Live and completed Khanewal customer orders."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Real-time responsive in-app notifications and push alerts."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Public customer reviews."
    }
  }
}
